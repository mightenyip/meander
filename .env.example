# ============================================================
# Meander – Environment Variables
# Copy this file to .env and fill in your values.
# For Streamlit Cloud: add these under Settings → Secrets.
# ============================================================

# ----------------------------------------------------------
# Supabase (required to enable the paywall)
# Find these at: https://app.supabase.com → Project Settings → API
# ----------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ----------------------------------------------------------
# Stripe (required for payment processing)
# Find these at: https://dashboard.stripe.com/apikeys
# ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create products at https://dashboard.stripe.com/products
# then paste the Price ID (starts with price_...) for each plan below
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...

# ----------------------------------------------------------
# App URL (used to build Stripe redirect URLs)
# Set to your Streamlit Cloud URL in production
# ----------------------------------------------------------
APP_URL=https://your-app.streamlit.app

# ----------------------------------------------------------
# Supabase: required tables
# Run these SQL statements in your Supabase SQL editor
# at https://app.supabase.com → SQL Editor
# ----------------------------------------------------------
#
# CREATE TABLE free_usage (
#   id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#   email       text NOT NULL UNIQUE,
#   used_at     timestamptz NOT NULL DEFAULT now(),
#   script_name text
# );
#
# CREATE TABLE subscribers (
#   id                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#   email               text NOT NULL UNIQUE,
#   stripe_customer_id  text,
#   stripe_sub_id       text,
#   plan                text NOT NULL DEFAULT 'pro',
#   status              text NOT NULL DEFAULT 'active',
#   created_at          timestamptz NOT NULL DEFAULT now(),
#   updated_at          timestamptz NOT NULL DEFAULT now()
# );
#
# ----------------------------------------------------------
# Stripe Webhooks
# ----------------------------------------------------------
# Stripe needs to call your app when subscriptions change.
# Streamlit Community Cloud doesn't support webhook endpoints natively.
#
# Options:
#   A) Use a free Railway/Render microservice as the webhook receiver
#      — it receives the event and writes to Supabase directly.
#   B) Use Stripe's built-in "no-code" subscriber sync via Supabase
#      integration (still in beta, worth checking).
#
# Events to listen for:
#   - checkout.session.completed
#   - customer.subscription.updated
#   - customer.subscription.deleted
